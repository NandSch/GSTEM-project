" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#666666;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="gnss2" target="gnssant2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d_ant_lora" value="SX1262 RF · U.FL/IPEX → SMA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9673a6;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="xiao" target="loraant2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d_xiao_shifter" value="UART TX/RX · 3,3 V" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#70ad47;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="xiao" target="level2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d_shifter_terminal" value="UART TX/RX · 5 V-zijde" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#70ad47;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="level2" target="terminal2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d_terminal_uno" value="4 draden: GND / +5 V / TX / RX&lt;br&gt;UART; CSV-commando ESP → Uno" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#70ad47;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="terminal2" target="uno2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d_uno_servos" v