<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Pi coding agent" version="24.7.17" type="device"><diagram id="system-communication" name="Systeemcommunicatie"><mxGraphModel dx="1700" dy="1040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="z_laptop" value="&lt;b&gt;LAPTOP EN SOFTWARE&lt;/b&gt;&lt;br&gt;USB-ontvanger wordt als USB-stick gebruikt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#6c8ebf;strokeWidth=2;fontStyle=1;fontSize=16;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="25" y="80" width="360" height="770" as="geometry" /></mxCell><mxCell id="z_receiver" value="&lt;b&gt;USB-LoRa-ONTVANGER&lt;/b&gt;&lt;br&gt;tweede identieke XIAO-kit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf5ff;strokeColor=#9673a6;strokeWidth=2;fontStyle=1;fontSize=16;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="415" y="210" width="235" height="390" as="geometry" /></mxCell><mxCell id="z_module" value="&lt;b&gt;MEETTOESTEL&lt;/b&gt;&lt;br&gt;Draagprint met modules in 3D-geprinte behuizing met demping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3faf3;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=16;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="680" y="80" width="635" height="770" as="geometry" /></mxCell><mxCell id="z_aircraft" value="&lt;b&gt;STILSTAANDE VLIEGTUIGMOCK-UP&lt;/b&gt;&lt;br&gt;Arduino Uno, roeren en servo’s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d6b656;strokeWidth=2;fontStyle=1;fontSize=16;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1340" y="170" width="330" height="630" as="geometry" /></mxCell><mxCell id="e_api" value="Lokale API: metingen als JSON → extern programma&lt;br&gt;commando als CSV ← terug (transport nog te kiezen)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9673a6;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="app" target="external"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_ntrip" value="Internet: NTRIP levert RTCM-correcties aan de app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="ntrip" target="app"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_usb" value="USB-A ↔ USB-C&lt;br&gt;USB-serieel: telemetrie ↑ en commando’s ↓" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#3d85c6;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="app" target="receiver"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_lora" value="LoRa, beoogd 868 MHz*&lt;br&gt;meetdata ↑ · CSV-commando’s + RTCM ↓" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#9673a6;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="receiver" target="esp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_app_ntrip_path" value="RTCM via USB-serieel ↓" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="app" target="receiver"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_imu" value="I²C · SDA/SCL · 3,3 V-logica" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2f75b5;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="imu" target="esp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_baro" value="I²C · SDA/SCL · 3,3 V-logica" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2f75b5;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="baro" target="esp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_gnss" value="UART: positie/metingen ↑&lt;br&gt;RTCM-correcties ↓ (route te valideren)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#70ad47;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="gnss" target="esp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_gnss_ant" value="GNSS RF · SMA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#666666;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="gnss_ant" target="gnss"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_lora_ant" value="SX1262 RF · IPEX/U.FL → SMA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9673a6;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="esp" target="lora_ant"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_receiver_ant" value="LoRa RF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9673a6;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="receiver" target="receiver_ant"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_uart_esp_shifter" value="UART TX/RX · 3,3 V" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#70ad47;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="esp" target="shifter"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_shifter_terminal" value="TX/RX · niveau 3,3 ↔ 5 V" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#70ad47;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="shifter" target="terminal"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_terminal_uno" value="4-aderige kabel: GND, +5 V, TX, RX&lt;br&gt;CSV-commando’s ESP → Uno; retourverkeer niet vastgelegd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#70ad47;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="terminal" target="uno"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_uno_servo" value="PWM-servosignalen&lt;br&gt;rolroeren · hoogteroer · richtingsroer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#70ad47;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="uno" target="servos"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_buck_servo" value="afzonderlijke servovoeding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="servo_buck" target="servos"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="app" value="&lt;b&gt;Laptopapplicatie&lt;/b&gt;&lt;br&gt;• verbindingsstatus USB + meettoestel&lt;br&gt;• kaart + live meetwaardentabel&lt;br&gt;• Code-modus: berekent CSV-commando’s&lt;br&gt;• API-modus: koppeling met extern programma&lt;br&gt;• opslag van meetdata/route (beoogd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="145" width="310" height="215" as="geometry" /></mxCell><mxCell id="external" value="&lt;b&gt;Extern programma (optioneel)&lt;/b&gt;&lt;br&gt;Ontvangt live meetdata als JSON via de lokale API en kan een vrije CSV-commando-regel terugsturen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="410" width="310" height="110" as="geometry" /></mxCell><mxCell id="ntrip" value="&lt;b&gt;NTRIP-correctiedienst&lt;/b&gt;&lt;br&gt;Internet op de laptop → RTCM-correcties naar de GNSS-rover&lt;br&gt;Provider nog te kiezen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="570" width="310" height="105" as="geometry" /></mxCell><mxCell id="laptop_note" value="&lt;b&gt;Op de laptop&lt;/b&gt;&lt;br&gt;USB-ontvanger wordt ingeplugd; de app start volgens de gebruikersspecificatie automatisch. De app controleert USB apart van geldige meetpakketten via LoRa." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="715" width="310" height="105" as="geometry" /></mxCell><mxCell id="receiver" value="&lt;b&gt;USB-LoRa-adapter&lt;/b&gt;&lt;br&gt;XIAO ESP32S3 + Wio-SX1262-kit&lt;br&gt;USB-serieel ↔ laptop&lt;br&gt;ontvangt meetdata en zendt downlink terug" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="435" y="300" width="195" height="145" as="geometry" /></mxCell><mxCell id="receiver_ant" value="&lt;b&gt;LoRa-antenne&lt;/b&gt;&lt;br&gt;bij de kit&lt;br&gt;ontvangerzijde" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="445" y="490" width="175" height="70" as="geometry" /></mxCell><mxCell id="imu" value="&lt;b&gt;9-DoF IMU&lt;/b&gt;&lt;br&gt;Adafruit BNO085&lt;br&gt;oriëntatie/beweging · I²C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="710" y="175" width="195" height="90" as="geometry" /></mxCell><mxCell id="baro" value="&lt;b&gt;Barometer&lt;/b&gt;&lt;br&gt;Adafruit BMP581&lt;br&gt;druk/temperatuur · I²C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="710" y="305" width="195" height="90" as="geometry" /></mxCell><mxCell id="gnss" value="&lt;b&gt;RTK-GNSS rover&lt;/b&gt;&lt;br&gt;Waveshare LC29H(DA) HAT&lt;br&gt;UART · positie/snelheid · RTCM-invoer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="710" y="435" width="195" height="100" as="geometry" /></mxCell><mxCell id="gnss_ant" value="&lt;b&gt;Actieve dual-band GNSS-antenne&lt;/b&gt;&lt;br&gt;L1/L5 · meegeleverd bij HAT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="710" y="565" width="195" height="65" as="geometry" /></mxCell><mxCell id="esp" value="&lt;b&gt;Meetcontroller + LoRa&lt;/b&gt;&lt;br&gt;XIAO ESP32S3 + Wio-SX1262-kit&lt;br&gt;leest sensoren, bundelt meetpakketten,&lt;br&gt;stuurt telemetrie via LoRa, geeft&lt;br&gt;besturingscommando’s door naar UART&lt;br&gt;en bewaakt lokaal de failsafe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1010" y="285" width="250" height="155" as="geometry" /></mxCell><mxCell id="lora_ant" value="&lt;b&gt;LoRa-antenne&lt;/b&gt;&lt;br&gt;kitantenne via U.FL/IPEX–SMA-pigtail&lt;br&gt;buiten de behuizing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="165" width="195" height="70" as="geometry" /></mxCell><mxCell id="shifter" value="&lt;b&gt;Level shifter&lt;/b&gt;&lt;br&gt;TXB0108-module volgens bestellijst*&lt;br&gt;3,3 V ↔ 5 V UART" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1005" y="485" width="135" height="100" as="geometry" /></mxCell><mxCell id="terminal" value="&lt;b&gt;4-pins connector&lt;/b&gt;&lt;br&gt;3,5 mm · GND / +5 V / TX / RX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1155" y="485" width="135" height="100" as="geometry" /></mxCell><mxCell id="power" value="&lt;b&gt;Voeding op draagprint&lt;/b&gt;&lt;br&gt;2S LiPo 7,4 V + barrel-invoer → 2 A PTC + TVS SMBJ10A → buck 5 V → 5 V-rail.&lt;br&gt;AP2112K-3.3 maakt een schone 3,3 V-rail voor sensoren/TXB0108. Gemeenschappelijke GND; bulk-elco 100 µF, ontkoppelcondensatoren en power-LED + 330 Ω.&lt;br&gt;Geen P-MOSFET-ompoolbeveiliging." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="705" y="665" width="585" height="160" as="geometry" /></mxCell><mxCell id="uno" value="&lt;b&gt;Arduino Uno&lt;/b&gt;&lt;br&gt;Ontvangt CSV via UART TX/RX en stelt servo’s in.&lt;br&gt;De exacte veldvolgorde en baudrate zijn nog niet vastgelegd." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="275" width="210" height="155" as="geometry" /></mxCell><mxCell id="servos" value="&lt;b&gt;Servo’s (3+)&lt;/b&gt;&lt;br&gt;• rolroeren (links/rechts)&lt;br&gt;• hoogteroer&lt;br&gt;• richtingsroer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1385" y="510" width="240" height="105" as="geometry" /></mxCell><mxCell id="servo_buck" value="&lt;b&gt;Aparte buck-converter&lt;/b&gt;&lt;br&gt;voeding servo’s&lt;br&gt;ingang/voedingsbron nog te controleren" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1395" y="660" width="220" height="85" as="geometry" /></mxCell><mxCell id="airframe_note" value="&lt;b&gt;3D-geprinte romp en stuurvlakken&lt;/b&gt;&lt;br&gt;Stilstaande demonstratie; geen vliegend/volledig functioneel vliegtuig." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1370" y="755" width="275" height="40" as="geometry" /></mxCell><mxCell id="legend1" value="&lt;b&gt;Leeswijzer&lt;/b&gt; — blauwe lijn: I²C · groene lijn: UART/CSV · paarse lijn: LoRa/RF · oranje lijn: voeding/correcties · pijlen in beide richtingen: bidirectioneel." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="25" y="875" width="1645" height="55" as="geometry" /></mxCell><mxCell id="caveat1" value="&lt;b&gt;Ontwerpstatus en aandachtspunten&lt;/b&gt;&lt;br&gt;* De actuele bestellijst gebruikt BNO085/BMP581 en een TXB0108-module; oudere projectnotities noemen BNO055/BMP390 en TXB0104. Variantsynchronisatie en definitieve modulekeuze moeten nog bevestigd worden. Pinout, 5 V-voeding van de Uno, servobuck-aansluiting, LoRa-pakketformaat/instellingen, API-transport, GNSS-correctieroute, CSV-veldvolgorde en baudrate zijn nog te valideren. 868 MHz is beoogd voor België, configuratie blijft open. Schematisch, niet op schaal." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="25" y="940" width="1645" height="75" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="carrier-wiring" name="Draagprint en UART-detail"><mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="z_carrier" value="&lt;b&gt;DRAAGPRINT / MEETTOESTEL&lt;/b&gt;&lt;br&gt;Modules, interfaces en voedingsboom (schematisch, niet op schaal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3faf3;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=16;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="25" y="80" width="1050" height="830" as="geometry" /></mxCell><mxCell id="z_mockup2" value="&lt;b&gt;ARDUINO EN MOCK-UP&lt;/b&gt;&lt;br&gt;stilstaande demonstratie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d6b656;strokeWidth=2;fontStyle=1;fontSize=16;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1100" y="80" width="570" height="830" as="geometry" /></mxCell><mxCell id="p_bat_prot" value="7,4 V VBAT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="battery" target="protection"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p_prot_buck" value="VBAT beschermd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="protection" target="buck5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p_buck_5v" value="5 V" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;fontColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="buck5" target="rail5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p_5v_esp" val