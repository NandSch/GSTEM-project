;spacing=8;" vertex="1" parent="1"><mxGeometry x="635" y="150" width="140" height="80" as="geometry" /></mxCell><mxCell id="ldo" value="&lt;b&gt;AP2112K-3.3&lt;/b&gt;&lt;br&gt;5 V → schone 3,3 V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="850" y="150" width="175" height="80" as="geometry" /></mxCell><mxCell id="rail3" value="&lt;b&gt;3,3 V-rail&lt;/b&gt;&lt;br&gt;common GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="850" y="270" width="175" height="70" as="geometry" /></mxCell><mxCell id="imu2" value="&lt;b&gt;IMU-breakout&lt;/b&gt;&lt;br&gt;Adafruit BNO085*&lt;br&gt;I²C · 9-DoF sensorfusie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="375" width="190" height="100" as="geometry" /></mxCell><mxCell id="baro2" value="&lt;b&gt;Barometer-breakout&lt;/b&gt;&lt;br&gt;Adafruit BMP581*&lt;br&gt;I²C · druk/temperatuur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="525" width="190" height="100" as="geometry" /></mxCell><mxCell id="gnss2" value="&lt;b&gt;GNSS HAT&lt;/b&gt;&lt;br&gt;Waveshare LC29H(DA)&lt;br&gt;RTK-rover · UART · 5 V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="695" width="190" height="105" as="geometry" /></mxCell><mxCell id="gnssant2" value="&lt;b&gt;GNSS-antenne&lt;/b&gt;&lt;br&gt;actief dual-band L1/L5&lt;br&gt;meegeleverd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="715" width="175" height="70" as="geometry" /></mxCell><mxCell id="xiao" value="&lt;b&gt;XIAO ESP32S3 + Wio-SX1262&lt;/b&gt;&lt;br&gt;centrale meetcontroller + LoRa-radio&lt;br&gt;op sockets op de draagprint&lt;br&gt;SX1262 wordt intern via SPI aangestuurd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="470" y="405" width="260" height="135" as="geometry" /></mxCell><mxCell id="loraant2" value="&lt;b&gt;LoRa-antenne&lt;/b&gt;&lt;br&gt;kitantenne via U.FL/IPEX–SMA-pigtail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="490" y="590" width="225" height="70" as="geometry" /></mxCell><mxCell id="level2" value="&lt;b&gt;TXB0108-module*&lt;/b&gt;&lt;br&gt;UART-levelshifter&lt;br&gt;3,3 V ↔ 5 V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="790" y="450" width="140" height="100" as="geometry" /></mxCell><mxCell id="terminal2" value="&lt;b&gt;4-pins 3,5 mm schroefklem&lt;/b&gt;&lt;br&gt;GND / +5 V / TX / RX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="935" y="450" width="120" height="100" as="geometry" /></mxCell><mxCell id="boardparts" value="&lt;b&gt;Overige draagprint-onderdelen&lt;/b&gt;&lt;br&gt;socketheaders; 100 µF bulk-elco; ontkoppelcondensatoren (100 nF + 10 µF/module); power-LED + 330 Ω; koperbanen, 4× M3-bevestiging en gemeenschappelijke GND. Controleer de pull-ups op BNO085/BMP581 en voorkom dubbele I²C-pull-ups." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="275" y="255" width="500" height="90" as="geometry" /></mxCell><mxCell id="shell" value="&lt;b&gt;Mechanisch&lt;/b&gt;&lt;br&gt;eigen 3D-geprinte behuizing met demping, M3-schroeven/afstandsbussen; LoRa-antenne buiten de behuizing." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="830" width="990" height="55" as="geometry" /></mxCell><mxCell id="uno2" value="&lt;b&gt;Arduino Uno&lt;/b&gt;&lt;br&gt;5 V-logica; ontvangt CSV via UART TX/RX en genereert servo-signalen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1160" y="280" width="210" height="145" as="geometry" /></mxCell><mxCell id="servos2" value="&lt;b&gt;Servo’s (3+)&lt;/b&gt;&lt;br&gt;rolroeren (links/rechts), hoogteroer, richtingsroer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1430" y="390" width="205" height="115" as="geometry" /></mxCell><mxCell id="servoBuck2" value="&lt;b&gt;Aparte buck-converter&lt;/b&gt;&lt;br&gt;voor servovoeding&lt;br&gt;bron/aansluiting nog te bevestigen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1150" y="585" width="215" height="90" as="geometry" /></mxCell><mxCell id="plane2" value="&lt;b&gt;3D-geprinte vliegtuigmock-up&lt;/b&gt;&lt;br&gt;servobewegingen worden mechanisch overgebracht op de stuurvlakken." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1395" y="650" width="245" height="105" as="geometry" /></mxCell><mxCell id="unknown2" value="&lt;b&gt;Controle vóór aansluiten&lt;/b&gt;&lt;br&gt;* De actuele bestellijst noemt BNO085/BMP581 en TXB0108; oudere notities noemen BNO055/BMP390 en TXB0104. Bevestig de definitieve varianten en breakout-pinnen.&lt;br&gt;De +5 V-pin op de connector is voorzien, maar de Uno-voeding, stroomlimiet en voorkomen van terugvoeding via USB moeten worden gecontroleerd. De servo’s krijgen een aparte buck; de voedingsbron daarvan moet worden afgestemd. Exacte baudrate/CSV-velden zijn nog open." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="25" y="925" width="1645" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>